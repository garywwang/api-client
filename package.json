{
  "name": "ApiClientTools",
  "displayName": "ApiClientTools",
  "description": "类 Apifox 的 HTTP 接口调试工具：环境 Host 配置、自动化测试、临时用例、Mock 数据、一键导出并导入 Postman / Apifox",
  "version": "1.0.15",
  "publisher": "garywwang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/garywwang/api-client.git"
  },
  "homepage": "https://open-vsx.org/extension/garywwang/api-client-tools",
  "bugs": {
    "url": "https://github.com/garywwang/api-client/issues"
  },
  "icon": "resources/icon1.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Testing"
  ],
  "keywords": [
    "http",
    "rest",
    "api",
    "postman",
    "apifox",
    "mock",
    "自动化测试"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "apiClient.open",
        "title": "API Client: 打开接口管理",
        "icon": "$(rocket)"
      },
      {
        "command": "apiClient.exportAll",
        "title": "API Client: 一键导出所有请求"
      },
      {
        "command": "apiClient.importCollection",
        "title": "API Client: 导入请求集合"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apiClient",
          "title": "API Client 接口管理",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "apiClient": [
        {
          "id": "apiClient.sidebar",
          "name": "打开工作台",
          "type": "webview",
          "contextualTitle": "API Client 启动器",
          "visibility": "collapsed"
        }
      ]
    },
    "configuration": {
      "title": "API Client",
      "properties": {
        "apiClient.requestTimeout": {
          "type": "number",
          "default": 30000,
          "minimum": 100,
          "description": "请求超时时间（毫秒）"
        },
        "apiClient.mockPort": {
          "type": "number",
          "default": 38999,
          "minimum": 1024,
          "maximum": 65535,
          "description": "本地 Mock 服务监听端口"
        },
        "apiClient.followRedirects": {
          "type": "boolean",
          "default": true,
          "description": "是否跟随重定向"
        }
      }
    }
  },
  "scripts": {
    "check": "node --check scripts/package-w.js && node --check src/extension.js && node --check src/httpClient.js && node --check src/scriptRunner.js && node --check src/exporter.js && node --check src/importer.js && node --check src/testRunner.js && node --check src/mockServer.js && node --check src/store.js && node --check src/environments.js && node --check src/webview/app.js && node --check src/webview/sidebar.js",
    "package": "vsce package --no-dependencies --allow-missing-repository $(node -p \"require('./package.json').repository ? '' : '--no-rewrite-relative-links'\") --out ../vsix/api-client-$(node -p \"require('./package.json').version\").vsix",
    "package:images": "vsce package --no-dependencies --allow-missing-repository --baseImagesUrl \"$APICLIENT_IMAGE_BASE_URL\" --out ../vsix/api-client-$(node -p \"require('./package.json').version\").vsix",
    "package:w": "node scripts/package-w.js"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  }
}
